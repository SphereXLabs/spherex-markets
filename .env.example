# SphereX Markets — optional environment variables
# Copy to `.env` (never commit real secrets)

# API server port (default: 3001)
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Cache TTL in seconds for live market data (default: 60)
CACHE_TTL=60

# Serve the Vite-built client from Express in production (default: false)
# Set to "true" after `npm run build` when using `npm start` alone
SERVE_CLIENT=false

# Optional CoinGecko API key (Demo/Pro) — improves rate limits when set
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Optional custom User-Agent for outbound market data requests
USER_AGENT=SphereXMarkets/1.0
